# Copy to deployhub-backend/.env and fill in. The real .env is git-ignored. NEVER commit it.
# Used by the "oracle" profile and by docker-compose.oracle.yml. See docs/oracle-setup.md.

# Option A: local Oracle in Docker (no cloud account needed)
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=deployhub_app
DB_PASSWORD=<choose a password: 12+ chars, upper, lower, digit>

# Option B: Oracle Autonomous Database (Always Free). <service> comes from the wallet's tnsnames.ora,
# e.g. deployhubdb_tp. TNS_ADMIN is the folder you unzipped the wallet into (outside this repo).
# DB_URL=jdbc:oracle:thin:@<service>?TNS_ADMIN=/Users/<you>/.oracle/wallets/deployhub
# DB_USERNAME=DEPLOYHUB_APP
# DB_PASSWORD=<app user password>

# Set to true whenever DeployHub is served over HTTPS (always in the cloud), so cookies get the Secure flag.
# SESSION_COOKIE_SECURE=true

# Encrypts project environment variables (AES-256-GCM). Create once with: openssl rand -base64 32
# Keep it safe and never change it: values stored with it can't be read with another key.
DEPLOYHUB_SECRETS_KEY=<paste the output of: openssl rand -base64 32>

# Paid deploys: Razorpay API keys (Dashboard > Account & Settings > API Keys). rzp_test_... = test mode, no real
# money. The secret stays on the server; never put it in the frontend or commit it.
RAZORPAY_KEY_ID=rzp_test_<your key id>
RAZORPAY_KEY_SECRET=<your key secret>

# AI assistant (optional). Default provider Gemini (free tier): key from aistudio.google.com.
# Or Claude (deployhub.assistant.provider=claude): key from console.anthropic.com. Without a key: built-in answers.
GEMINI_API_KEY=<your Gemini API key>
# ANTHROPIC_API_KEY=<your Anthropic API key>

# Email (sign-up, college email and forgot-password codes) via Gmail. MAIL_PASSWORD is a Google "App password"
# (16 letters; needs 2-Step Verification), not your normal Gmail password. Without these, codes go to the backend log.
MAIL_USERNAME=<yourname@gmail.com>
MAIL_PASSWORD=<16-letter app password>
